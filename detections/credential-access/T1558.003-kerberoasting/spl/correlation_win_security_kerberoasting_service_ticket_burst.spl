# Generated by scripts/convert.sh from rules/correlation_win_security_kerberoasting_service_ticket_burst.yml - do not edit.
# sigma-cli 3.1.0, backend splunk, pipelines: sysmon, pipelines/splunk_windows_xml.yml
# Prepend your index or macro, e.g. `windows_security` <query> or index=<your_index> <query>
source IN ("WinEventLog:Security", "XmlWinEventLog:Security") EventCode=4769 Status="0x0" NOT (ServiceName IN ("*$", "krbtgt"))

| bin _time span=10m
| stats dc(ServiceName) as value_count by _time TargetUserName IpAddress

| search value_count >= 5
